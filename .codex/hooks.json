{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/scripts/copy-env-files-from-local-checkout.sh\"",
            "statusMessage": "Copying local env files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/format_on_stop.sh\"",
            "statusMessage": "Formatting dirty Rust files",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
